{
  "name": "meridian-grant-operations",
  "version": "1.0.0",
  "private": true,
  "description": "Meridian — grant operations command center for nonprofit recipient teams",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0 <25"
  },
  "scripts": {
    "demo": "npm run demo:setup && DEMO_MODE=true npm run dev",
    "demo:setup": "tsx server/db/cli-setup.ts",
    "demo:reset": "tsx server/db/cli-reset.ts",
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "serve": "npm run demo:setup && npm run build && DEMO_MODE=true npm start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run e2e:seed && playwright test",
    "e2e:seed": "DATA_DIR=./.e2e-data tsx server/db/cli-reset.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "acceptance": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.2",
    "bcryptjs": "2.4.3",
    "better-sqlite3": "12.4.1",
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "helmet": "8.3.0",
    "lucide-react": "0.544.0",
    "multer": "2.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "7.6.13",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "4.17.23",
    "@types/multer": "2.0.0",
    "@types/node": "20.19.19",
    "@types/react": "18.3.25",
    "@types/react-dom": "18.3.7",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.1",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "6.3.6",
    "vitest": "3.2.4"
  }
}
