# GrantConsole — environment configuration
# Copy to .env for local overrides. Every value below has a safe development default,
# so the demo runs with no .env file at all.

# HTTP port for the API + production static server.
PORT=4000

# Network interface to bind. The default is loopback only, so the workspace is
# never reachable from other machines unless you opt in explicitly (e.g. 0.0.0.0).
HOST=127.0.0.1

# Set to "true" to show the seeded demo accounts and shared password on the
# sign-in screen. Never inferred from NODE_ENV, and refused outright in
# production. `npm run demo` and `npm run serve` set it for you.
DEMO_MODE=

# Where SQLite database and uploaded evidence files live (relative paths resolve from repo root).
DATA_DIR=./data

# Secret used to sign session cookies.
# Development falls back to an ephemeral generated secret and prints a warning.
# PRODUCTION: set this to a long random string (e.g. `openssl rand -hex 32`). The server
# refuses to boot in production without it.
SESSION_SECRET=

# Session lifetime in hours.
SESSION_TTL_HOURS=72

# Set to "production" to enable Secure cookies, strict origin checks and static file serving.
NODE_ENV=development

# Comma-separated list of extra origins permitted to send mutations (dev client, etc).
# Defaults already include http://localhost:5173 and http://localhost:4000 in development.
ALLOWED_ORIGINS=

# Max upload size in megabytes for evidence documents.
MAX_UPLOAD_MB=10

# Canonical public origin, used in robots.txt and sitemap.xml URLs.
SITE_URL=https://grantconsole.com

# GA4 measurement id (G-XXXXXXXXXX). Leave empty to ship no analytics at all —
# the landing page only includes Google's tag when this is set.
GA_MEASUREMENT_ID=

# ----------------------------------------------------------------- launch

# Public origin used in emails, invitation links and Stripe redirects. Defaults to SITE_URL.
APP_URL=

# Self-serve sign-up. Set to "false" to pause new workspaces without a deploy.
SIGNUPS_ENABLED=true

# Length of the free trial every new workspace receives.
TRIAL_DAYS=14

# Transactional email via Resend (https://resend.com). Without a key the app still
# works: invitation and reset links are shown in the UI / logged instead of emailed.
RESEND_API_KEY=
EMAIL_FROM="GrantConsole <support@grantconsole.com>"
EMAIL_REPLY_TO=support@grantconsole.com
# Internal lead alerts only. One monitored email address; blank uses the public support address.
LEAD_NOTIFICATION_EMAIL=

# Stripe billing. Checkout appears in Settings → Plan & billing only when the secret key
# and at least one price id are set; the webhook needs the signing secret. Create the
# products/prices in Stripe (monthly + annual per plan) and paste their price ids here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional note under the Checkout pay button (e.g. who issues receipts on a shared Stripe account)
STRIPE_CHECKOUT_NOTE=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_ANNUAL=

# Bearer token (24+ random characters) for the founder-only /api/admin endpoints:
# list workspaces and leads, and set a plan by hand for invoiced customers.
ADMIN_TOKEN=

# Hour (UTC) at which the public demo workspaces are reset to their seed each day.
DEMO_RESET_HOUR_UTC=9
